# Токен бота в MAX: платформа для партнёров или мини-приложение «MAX для бизнеса»,
# раздел «Чат-боты» → «Создать». Токен появляется после модерации.
# https://dev.max.ru/docs/chatbots/bots-create/create
MAX_BOT_TOKEN=

# Yandex AI Studio
folder_id=
api_key=
YANDEX_MODEL=deepseek-v4-flash

# Час, в который приходит дайджест (по времени компьютера, где запущен бот)
DIGEST_HOUR=8
